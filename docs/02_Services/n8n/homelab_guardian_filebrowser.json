{
  "name": "Homelab Guardian - FileBrowser Health Check & Self-Healing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        16,
        704
      ],
      "id": "e446c08a-945c-487b-a7e8-0d60470c7481",
      "name": "Every 5 Minutes"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=The current time is {{ $now }}. Check if {{ $env.FILEBROWSER_URL }} is responding correctly. Return your findings as structured output.",
        "options": {
          "systemMessage": "=## Role\nYou are 'Homelab Guardian'.\n\n## Detection Logic\n1. Use the HTTP Request Tool to fetch {{ $env.FILEBROWSER_URL }}.\n2. The site is ONLY 'UP' if the HTTP status is 200 AND the body contains the string 'FileBrowser'.\n3. If you get a 404, a 502, a redirect, a connection error, or the response body contains the word 'Caddy', the service is DOWN.\n\n## Response Rules\n- If the site is UP: set website_up to \"true\" and message to a short status summary.\n- If the site is DOWN: set website_up to \"false\" and message to a description of what you observed (status code, body snippet, error) and recommend restarting the filebrowser-quantum Docker container.\n- Do NOT attempt to run any Docker/SSH commands yourself. Only report your findings."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        352,
        592
      ],
      "id": "88411426-1512-44e3-bbd4-09e97f775e41",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-oss-20b",
          "mode": "list",
          "cachedResultName": "gpt-oss-20b"
        },
        "responsesApiEnabled": false,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        240,
        816
      ],
      "id": "5d7fbbb9-bc23-4c4e-8d34-071296420f5b",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "homelab-guardian-session"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        368,
        816
      ],
      "id": "f6d2d200-de25-4757-a771-3d8b81ada982",
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "toolDescription": "Use this to check that filebrowser service is up. Makes an HTTP GET request to the given URL and returns the status code and body.",
        "url": "={{ $env.FILEBROWSER_URL }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        496,
        816
      ],
      "id": "faf4747e-64ff-43b8-bf4f-46c37b6160ed",
      "name": "HTTP Request Tool"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\n\n// Extract the first valid JSON object from the output, ignoring any surrounding junk\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\n\nif (!match) {\n  // If we can't find JSON at all, assume the site is down and pass the raw output as the message\n  return [{ json: { website_up: \"false\", message: \"Agent returned unparseable output: \" + raw } }];\n}\n\ntry {\n  const parsed = JSON.parse(match[0]);\n  return [{ json: { website_up: parsed.website_up || \"false\", message: parsed.message || \"No message provided.\" } }];\n} catch (e) {\n  return [{ json: { website_up: \"false\", message: \"Failed to parse agent output: \" + raw } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        640
      ],
      "id": "360523e9-c29d-46c6-9d4c-a58896c0c6d6",
      "name": "Parse Agent Output"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "a3349b50-b72f-4e2b-adf6-e1e3aaa622d2",
              "leftValue": "={{ $json.website_up }}",
              "rightValue": "false",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        880,
