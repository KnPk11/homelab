# =============================================================================
# Spark on K8s Configuration Template & Security Parameters
# Environment parameters and hardening rules for Spark job dispatch to k3s
# =============================================================================
SPARK_MASTER_URL=k8s://https://192.168.50.96:6443
SPARK_NAMESPACE=spark
SPARK_SERVICE_ACCOUNT=spark
SPARK_CONTAINER_IMAGE=apache/spark:3.5.1

# Resource Boundaries & Driver Ports
SPARK_EXECUTOR_INSTANCES=2
SPARK_EXECUTOR_CORES=1
SPARK_EXECUTOR_MEMORY=512m
SPARK_DRIVER_HOST=192.168.50.96
SPARK_DRIVER_PORT=7078
SPARK_BLOCKMANAGER_PORT=7079

# Container Hardening & Pod Security Context
SPARK_EXECUTOR_RUN_AS_NON_ROOT=true
SPARK_EXECUTOR_RUN_AS_USER=10001
SPARK_EXECUTOR_CAPABILITIES_DROP=ALL
SPARK_REDACT_REGEX=(?i)secret|password|token|key|credentials
