[Unit]
Description=AI Telegram Terminal Suite Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/telegram-terminal
ExecStart=/usr/bin/node /opt/telegram-terminal/bot.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
