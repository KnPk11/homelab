# Telegram Bot Token from @BotFather
BOT_TOKEN=[TELEGRAM-BOT-TOKEN]

# Authorised Telegram numeric user ID(s) (comma-separated).
# Access is strictly tied to the sender's user ID (fromId). Group IDs are not permitted.
ALLOWED_CHAT_IDS=[TELEGRAM-USER-ID]

# Default AI execution engine ('agy' or 'grok')
DEFAULT_ENGINE=agy

# Default working directory
DEFAULT_CWD=/root

# Default AI models (list valid IDs with `agy models` / `grok models`)
DEFAULT_AGY_MODEL=gemini-3.8-flash-high
DEFAULT_GROK_MODEL=grok-4.7
