# Namecheap Dynamic DNS Configuration
# Obtain your Dynamic DNS Password from: Namecheap -> Advanced DNS -> Dynamic DNS

DOMAIN="example.com"
PASSWORD="your_namecheap_ddns_password"
HOSTS="ip"
# Optional: leave unset when cron already redirects stdout/stderr to /var/log/namecheap-ddns.log
# LOGFILE="/var/log/namecheap-ddns.log"
