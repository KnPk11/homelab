            <div style="display:flex;align-items:center;gap:10px;"><span style="font-size:14px;font-weight:200;width:100px;text-align:left;">History</span><img src="https://gatus.${HOMELAB_DOMAIN}/api/v1/endpoints/infrastructure_internet/uptimes/7d/badge.svg"><img src="https://gatus.${HOMELAB_DOMAIN}/api/v1/endpoints/infrastructure_internet/uptimes/30d/badge.svg"></div>
            </body>
          frameHeight: 50

