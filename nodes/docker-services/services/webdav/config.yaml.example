# =============================================================================
# WebDAV Server Configuration (hacdias/webdav)
# Place real runtime config at: /srv/webdav/config.yaml on docker-services
# =============================================================================

address: 0.0.0.0
port: 80
prefix: /
behindProxy: true

# Global defaults
directory: /data
permissions: CRUD

users:
  - username: K
    password: "{bcrypt}$2a$10$..." # or plain-text "your_password"
    directory: /data
    permissions: CRUD
    rules: []
