# =============================================================================
# Lychee Environment Configuration Template
# Place actual secrets in /srv/lychee/.env (chmod 600 root:root)
# =============================================================================
APP_KEY=base64:YOUR_32_BYTE_BASE64_KEY_HERE=
APP_URL=https://lychee.example.com

# Initial Admin Credentials (documented for fresh setup / recovery)
INITIAL_ADMIN_USER=k
INITIAL_ADMIN_PASSWORD=your_secure_password_here
